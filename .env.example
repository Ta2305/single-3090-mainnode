# このファイルを .env にコピーして値を編集してください(.env はコミット対象外)。
# main.py / eval/run_eval.py / eval/run_eval_mainonly.py が起動時に読み込みます。

# メインLLM(vLLM)サーバーへの接続先。設定した場合はMAIN_VLLM_PORTより優先される。
# MAIN_VLLM_BASE_URL=http://localhost:8000

# ホストがlocalhost固定でよい場合は、ポート番号だけの指定でも足りる。
MAIN_VLLM_PORT=8000

# メインLLMの`model`フィールドに使う名前。`vllm serve --served-model-name <name>`
# で指定した名前と厳密に一致させること(不一致だと404 model not foundになる)。
MAIN_MODEL_NAME=default

# イベントログ・実行ログの出力先ディレクトリ(省略時 ./logs)
LOG_DIR=./logs
